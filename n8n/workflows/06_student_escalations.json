{
  "name": "06 \u00b7 Nightly student rules \u2192 nudges, parent alerts, tutor triggers",
  "nodes": [
    {
      "id": "8efd4dc2-3074-57bb-b8c4-4351de1708b1",
      "name": "Daily 21:30 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 21 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "3a137429-198d-5b39-b71f-75ff7aceb978",
      "name": "Evaluate rules",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Each rule returns (student_id, rule, notified). Thresholds live in one table so the\n-- weekly review can tune them without touching the workflow.\nWITH th AS (SELECT * FROM escalation_thresholds),\noverdue AS (\n  SELECT student_id, CASE WHEN CURRENT_DATE - due_on >= 5 THEN 'parent' ELSE 'student' END AS notified, 'task_overdue' AS rule\n  FROM tasks WHERE source = 'advisor' AND completed_on IS NULL AND CURRENT_DATE - due_on IN (2, 5)\n),\nquiz AS (\n  SELECT s.student_id, 'student' AS notified, 'quiz_missed_3d' AS rule FROM students s\n  WHERE NOT EXISTS (SELECT 1 FROM quiz_attempts a JOIN quizzes q USING (quiz_id)\n                    WHERE a.student_id = s.student_id AND q.quiz_date > CURRENT_DATE - 3)\n),\nfocus AS (\n  SELECT s.student_id, 'student', 'no_focus_3d' FROM students s\n  WHERE EXISTS (SELECT 1 FROM focus_sessions f WHERE f.student_id = s.student_id AND f.started_at > now() - interval '30 days')\n    AND NOT EXISTS (SELECT 1 FROM focus_sessions f WHERE f.student_id = s.student_id AND f.started_at > now() - interval '3 days')\n),\ngap AS (   -- latest exam 10+ points under target in a subject with no tutor -> tutor support\n  SELECT sb.student_id, 'tutor', 'readiness_gap' FROM exam_results r\n  JOIN subjects sb USING (subject_id) JOIN exam_targets t ON t.subject_id = r.subject_id AND t.exam_type = r.exam_type\n  WHERE r.exam_date = (SELECT MAX(exam_date) FROM exam_results) AND r.score_pct - t.target_pct <= -(SELECT readiness_gap_pts FROM th)\n    AND NOT sb.has_tutor\n)\nSELECT * FROM overdue UNION ALL SELECT * FROM quiz UNION ALL SELECT * FROM focus UNION ALL SELECT * FROM gap;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "supabase-pg",
          "name": "Supabase Postgres (alcovia)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "39350d27-d38f-5b4a-a1ff-0e2e16e0b6a5",
      "name": "Log escalation (once per rule per day)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO escalations (escalation_id, student_id, rule, triggered_on, notified)\nVALUES ('esc_' || $1 || '_' || $2 || '_' || to_char(CURRENT_DATE, 'YYYYMMDD'), $1, $2, CURRENT_DATE, $3)\nON CONFLICT (escalation_id) DO NOTHING RETURNING escalation_id, student_id, rule, notified;",
        "options": {
          "queryReplacement": "={{ $json.student_id }},={{ $json.rule }},={{ $json.notified }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "supabase-pg",
          "name": "Supabase Postgres (alcovia)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "65fc9384-767a-52da-a079-4ce8fe4362d6",
      "name": "Who gets it",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        720,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.notified }}",
                    "rightValue": "student",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "student"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.notified }}",
                    "rightValue": "parent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "parent"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.notified }}",
                    "rightValue": "tutor",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "tutor"
            }
          ]
        }
      }
    },
    {
      "id": "6cda4d3f-2e84-592c-ade8-94ee27f4d9bd",
      "name": "App push to student",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
