        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"student_id\": \"{{ $json.student_id }}\", \"template\": \"{{ $json.rule }}\" }"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "464f6a38-a0a8-5491-b5cf-39cd867e6034",
      "name": "WhatsApp to parent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API }}/messages",
        "options": {
          "timeout": 30000
