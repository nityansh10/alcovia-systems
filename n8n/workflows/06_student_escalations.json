        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"to_student_parent\": \"{{ $json.student_id }}\", \"template\": \"parent_{{ $json.rule }}\" }"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "1429ad14-b0ad-5f27-9b28-e0b8627b4237",
      "name": "Tutor-support task for advisor",
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
      "position": [
        1200,
        460
      ],
      "parameters": {
        "team": "={{ $env.CLICKUP_TEAM_ID }}",
        "space": "={{ $env.CLICKUP_PROGRAM_SPACE }}",
        "list": "={{ $env.CLICKUP_ADVISOR_LIST }}",
        "name": "=Arrange tutor support: {{ $json.student_id }} is 10+ pts under target",
        "additionalFields": {
          "priority": 2,
          "tags": [
            "tutor-trigger"
          ]
        }
      },
      "credentials": {
        "clickUpApi": {
          "id": "clickup",
          "name": "ClickUp (alcovia workspace)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
