            }
          ]
        }
      }
    },
    {
      "id": "ab6be733-ff13-5821-8a46-31b013f7e308",
      "name": "Mark recovered behaviour as resolved",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        700
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE escalations e SET resolved_on = CURRENT_DATE\nWHERE resolved_on IS NULL AND (\n  (rule = 'task_overdue'   AND NOT EXISTS (SELECT 1 FROM tasks t WHERE t.student_id = e.student_id AND t.source = 'advisor' AND t.completed_on IS NULL AND t.due_on < CURRENT_DATE - 1))\n  OR (rule = 'quiz_missed_3d' AND EXISTS (SELECT 1 FROM quiz_attempts a JOIN quizzes q USING (quiz_id) WHERE a.student_id = e.student_id AND q.quiz_date > e.triggered_on))\n  OR (rule = 'no_focus_3d'    AND EXISTS (SELECT 1 FROM focus_sessions f WHERE f.student_id = e.student_id AND f.started_at::date > e.triggered_on))\n);",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "supabase-pg",
          "name": "Supabase Postgres (alcovia)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
